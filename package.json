{
  "name": "party-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,host,ctrl -c blue,green,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/host\" \"npm run dev -w apps/controller\"",
    "build": "npm run build -w apps/host -w apps/controller",
    "start": "npm run start -w apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "fake:host": "npm run fake:host -w apps/server",
    "fake:controller": "npm run fake:controller -w apps/server",
    "tunnel": "ngrok http 8787",
    "tunnel:dev": "ngrok http 5174"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
